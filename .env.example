# =============================================================================
# Ticxnova-AI — Environment variables
# =============================================================================

# --- Supabase (client-safe — anon key only) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Stripe Price IDs (public — safe in frontend .env) ---
# Production Netlify builds use live IDs from netlify.toml.
# Local `npm run dev` falls back to test IDs unless you set the vars below.

# Test mode (sk_test / rk_test):
VITE_STRIPE_STARTER_PRICE_ID=price_1TrSG9H1xnYBWgiR8Jrks4o6
VITE_STRIPE_PROFESSIONAL_PRICE_ID=price_1TrSGAH1xnYBWgiRiENaDWTk
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_1TrSGAH1xnYBWgiRkChP3iJc

# Live mode (sk_live / rk_live) — already set for production in netlify.toml:
# VITE_STRIPE_STARTER_PRICE_ID=price_1TezkkH1xnYBWgiRHnzscJTe
# VITE_STRIPE_PROFESSIONAL_PRICE_ID=price_1TezsyH1xnYBWgiRWJdPkNSn
# VITE_STRIPE_ENTERPRISE_PRICE_ID=price_1TezwAH1xnYBWgiRaK6gLtRa

# =============================================================================
# Supabase Edge Function secrets (never commit real values)
# =============================================================================
#
# STRIPE_SECRET_KEY=sk_live_xxx   # prefer a restricted key (rk_live) in production
# STRIPE_WEBHOOK_SECRET=whsec_xxx
#
# Price IDs are chosen automatically from the secret prefix by:
#   ./scripts/set-stripe-secrets.sh
# Webhook endpoint:
#   ./scripts/ensure-stripe-webhook.sh
#
# =============================================================================
# Deploy checklist
# =============================================================================
#
# 1. Apply supabase/migrations/20260828000000_go_live_hardening.sql
# 2. STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... ./scripts/set-stripe-secrets.sh
# 3. ./scripts/ensure-stripe-webhook.sh
# 4. supabase functions deploy create-checkout-session create-billing-portal-session \
#      confirm-checkout-session stripe-webhook --project-ref oouewpzzeqqykzzfvmcq
# 5. Stripe Dashboard → Customer portal → allow customers to update subscriptions
# 6. npm run test && npm run build
#
# Unlock path: Checkout → webhook and/or confirm-checkout-session → tenant.subscription_status=active
